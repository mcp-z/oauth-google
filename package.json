{
  "name": "@mcp-z/oauth-google",
  "version": "2.3.0",
  "description": "OAuth 2.0 client for Google APIs with multi-account support, PKCE security, and swappable storage backends",
  "keywords": [
    "oauth2",
    "google-api",
    "authentication",
    "multi-account",
    "gmail",
    "google-drive",
    "google-sheets",
    "pkce",
    "googleapis",
    "token-storage",
    "cimd",
    "client-id-metadata"
  ],
  "homepage": "https://github.com/mcp-z/oauth-google#readme",
  "bugs": {
    "url": "https://github.com/mcp-z/oauth-google/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-z/oauth-google.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff.info@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "format": "tsds format",
    "prepublish:check": "ncp",
    "prepublishOnly": "node scripts/require-dist-tag.cjs && tsds validate",
    "test": "tsds test:node --require test/lib/env-loader.ts --no-timeouts",
    "test:ci": "tsds test:node --require test/lib/env-loader.ts --no-timeouts --ignore \"test/integration/dcr.test.ts\" --ignore \"test/integration/dcr-refresh.test.ts\" --ignore \"test/integration/loopback.test.ts\" --ignore \"test/unit/providers/**\"",
    "test:ci:engines": "nvu engines tsds test:node --require test/lib/env-loader.ts --no-timeouts --ignore \"test/integration/dcr.test.ts\" --ignore \"test/integration/dcr-refresh.test.ts\" --ignore \"test/integration/loopback.test.ts\" --ignore \"test/unit/providers/**\"",
    "test:engines": "nvu engines tsds test:node --require test/lib/env-loader.ts --no-timeouts",
    "test:setup": "node test/lib/setup-token.ts",
    "version": "tsds version"
  },
  "dependencies": {
    "@mcp-z/oauth": "^2.1.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@googleapis/drive": "^26.0.0",
    "@googleapis/gmail": "^22.0.0",
    "@googleapis/sheets": "^18.0.0",
    "@mcp-z/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "cors": "^2.0.0",
    "get-port": "5.1.1",
    "keyv": "^5.0.0",
    "keyv-file": "5.3.3",
    "node-version-use": "^2.4.7",
    "ts-dev-stack": "^1.22.1",
    "tsds-config": "^1.0.4",
    "tsds-lib": "^1.22.6"
  },
  "peerDependencies": {
    "keyv": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "tsds": {
    "source": "src/index.ts"
  }
}
